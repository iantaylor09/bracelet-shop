    "faq_anchor": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div id=\"faq\"></div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long will my order take?",
            "icon": "truck",
            "row_content": "<p>Each bracelet is made to order, usually within 3 to 5 working days, then sent by Royal Mail. You'll get an email when it's on its way.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I return a bracelet?",
            "icon": "return",
            "row_content": "<p>Ready-made bracelets can be returned unworn within 14 days. Custom designs are made just for you, so they can't be returned unless they arrive faulty, but I'm happy to resize one if the fit isn't right.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What are the beads made of?",
            "icon": "question_mark",
            "row_content": "<p>The beads are 6 mm polymer clay heishi discs, threaded on strong cord with a metal clasp.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I look after my bracelet?",
            "icon": "heart",
            "row_content": "<p>Take it off before swimming, showering or exercising, and keep it away from perfume and lotions.</p>"
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I send it as a gift?",
            "icon": "box",
            "row_content": "<p>Yes. Choose gift wrap at checkout and add a note, and I'll leave the price off the packing slip.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "caption": "Questions",
