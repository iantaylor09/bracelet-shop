{%- assign s = section.settings -%}
<section class="tb-section tb-pad-large color-{{ s.color_scheme }} gradient">
  <div class="page-width tb-404">
    {%- render 'tb-stitching-bird' -%}
    {%- if s.eyebrow != blank -%}<p class="tb-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="tb-display">{{ s.heading | escape }}</h1>
    {%- if s.text != blank -%}<div class="tb-lede">{{ s.text }}</div>{%- endif -%}
    <div class="tb-buttons">
      {%- if s.button_label != blank -%}<a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>{%- endif -%}
      {%- if s.button2_label != blank -%}<a class="button button--secondary" href="{{ s.button2_link | default: routes.root_url }}">{{ s.button2_label | escape }}</a>{%- endif -%}
    </div>
    {%- if s.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="tb-404__search">
        <label class="visually-hidden" for="TbSearch404">Search the shop</label>
        <input id="TbSearch404" type="search" name="q" placeholder="Search for a piece">
        <button type="submit" class="button button--secondary">Search</button>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tailorbird page not found",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Page not found" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Like a bead rolling under the table, this page has gone missing. Let's get you back on the thread.</p>" },
    { "type": "text", "id": "button_label", "label": "Main button label", "default": "Shop the collections" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Back to the home page" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "checkbox", "id": "show_search", "label": "Show a search box", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "Tailorbird page not found" } ]
}
{% endschema %}
