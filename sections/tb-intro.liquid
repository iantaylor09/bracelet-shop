{%- assign s = section.settings -%}
<section {% if s.anchor != blank %}id="{{ s.anchor | handleize }}"{% endif %} class="tb-section color-{{ s.color_scheme }} gradient tb-pad-{{ s.padding }}">
  <div class="page-width tb-intro-block tb-intro-block--{{ s.alignment }}">
    {%- if s.show_bird -%}<img class="tb-bird tb-bird--lg" src="{{ 'tailorbird-bird.svg' | asset_url }}" alt="" width="64" height="51" loading="lazy">{%- endif -%}
    {%- if s.eyebrow != blank -%}<p class="tb-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}
      {%- if s.is_page_title -%}<h1 class="tb-display">{{ s.heading | escape }}</h1>{%- else -%}<h2 class="tb-h2">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- endif -%}
    {%- if s.text != blank -%}<div class="tb-lede">{{ s.text }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tailorbird intro",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_bird", "label": "Show the little bird", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "is_page_title", "label": "This is the page title", "default": true },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding", "label": "Space above and below", "default": "medium", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "text", "id": "anchor", "label": "Link anchor" }
  ],
  "presets": [ { "name": "Tailorbird intro" } ]
}
{% endschema %}
