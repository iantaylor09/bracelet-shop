{{ 'bracelet-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bracelet-banner.js' | asset_url }}" defer="defer"></script>

<section
  id="{{ section.settings.anchor | default: 'bestsellers' }}"
  class="bracelet-banner color-{{ section.settings.color_scheme }} gradient"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.label | escape }}"
  data-bracelet-banner
  data-interval="{{ section.settings.interval }}"
>
  <div class="bbn-slides">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <div
        class="bbn-slide{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ forloop.length }}"
        {{ block.shopify_attributes }}
      >
        <div class="page-width bbn-inner">
          <div class="bbn-copy">
            {%- if block.settings.tag != blank -%}<p class="bbn-eyebrow">{{ block.settings.tag | escape }}</p>{%- endif -%}
            <h2 class="hxl">{{ block.settings.heading | default: p.title | escape }}</h2>
            {%- if block.settings.text != blank -%}
              <div class="bbn-text">{{ block.settings.text }}</div>
            {%- elsif p.description != blank -%}
              <div class="bbn-text"><p>{{ p.description | strip_html | truncatewords: 24 }}</p></div>
            {%- endif -%}
            <div class="bbn-buy">
              {%- if p != blank -%}
                <span class="bbn-price">{{ p.price | money }}{% if block.settings.price_note != blank %} <small>{{ block.settings.price_note | escape }}</small>{% endif %}</span>
              {%- endif -%}
              <div class="bbn-cta">
                {%- if p != blank and p.available -%}
                  <form action="{{ routes.cart_add_url }}" method="post">
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="button">Add to basket</button>
                  </form>
                {%- elsif p != blank -%}
                  <button type="button" class="button" disabled>Sold out</button>
                {%- endif -%}
                {%- if block.settings.pattern != blank -%}
                  <button
                    type="button"
                    class="button button--secondary"
                    data-pattern="{{ block.settings.pattern | escape }}"
                    data-name="{{ block.settings.heading | default: p.title | escape }}"
                  >
                    Customise this design
                  </button>
                {%- endif -%}
              </div>
            </div>
          </div>
          <div class="bbn-art">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 70vw', alt: '' }}
            {%- elsif block.settings.fallback_image != blank -%}
              <img src="{{ block.settings.fallback_image | asset_url }}" alt="" loading="lazy" width="665" height="665">
            {%- endif -%}
            <svg viewBox="0 0 400 400" aria-hidden="true" data-colours="{{ block.settings.ring_colours | remove: ' ' | escape }}"></svg>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="bbn-ctrl page-width">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="bbn-dot{% if forloop.first %} is-active{% endif %}"
          aria-label="Show slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
      <button type="button" class="bbn-pause" data-pause>Pause</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bestseller banner",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Bestselling bracelets" },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "text", "id": "anchor", "label": "Link anchor", "default": "bestsellers" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Bestseller",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "tag", "label": "Label", "default": "Bestseller" },
        { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the product title." },
        { "type": "richtext", "id": "text", "label": "Text", "info": "Defaults to the start of the product description." },
        { "type": "text", "id": "price_note", "label": "Price note", "default": "Women's Medium" },
        {
          "type": "text", "id": "pattern", "label": "Builder pattern",
          "info": "Comma-separated bead names from the bracelet builder, repeated around the bracelet when someone taps Customise. Leave blank to hide the button."
        },
        {
          "type": "text", "id": "ring_colours", "label": "Ring colours",
          "info": "Comma-separated hex colours for the animated bead ring.",
          "default": "#1f3c8f,#4f8fd6,#93d6a2,#2f8a55,#f3f4f1,#1b6a3b"
        },
        { "type": "text", "id": "fallback_image", "label": "Preview image file", "info": "Theme asset file name, only used until a product is chosen." }
      ]
    }
  ],
  "presets": [ { "name": "Bestseller banner", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}
