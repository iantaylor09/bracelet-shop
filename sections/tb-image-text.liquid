{%- assign s = section.settings -%}
<section
  {% if s.anchor != blank %}id="{{ s.anchor | handleize }}"{% endif %}
  class="tb-section tb-pad-{{ s.padding }}{% if s.layout == 'band' %} color-{{ s.color_scheme }} gradient{% endif %}"
>
  <div class="page-width">
    <div class="tb-split tb-split--{{ s.layout }} tb-split--image-{{ s.image_position }}{% if s.layout == 'card' %} color-{{ s.color_scheme }}{% endif %}">
      <div class="tb-split__media">
        {%- render 'tb-media', image: s.image, label: s.placeholder, ratio: s.ratio, sizes: '(min-width: 990px) 50vw, 100vw' -%}
      </div>
      <div class="tb-split__copy">
        {%- if s.show_bird -%}
          <img class="tb-bird" src="{{ 'tailorbird-bird.svg' | asset_url }}" alt="" width="48" height="38" loading="lazy">
        {%- endif -%}
        {%- if s.eyebrow != blank -%}<p class="tb-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}
          {%- if s.is_page_title -%}
            <h1 class="tb-{{ s.heading_size }}">{{ s.heading | escape }}</h1>
          {%- else -%}
            <h2 class="tb-{{ s.heading_size }}">{{ s.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if s.text != blank -%}<div class="tb-rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.note != blank -%}
          <p class="tb-note-pill">{%- render 'tb-icon', icon: 'clock' -%}<span>{{ s.note | replace: '[making time]', settings.tb_making_time }}</span></p>
        {%- endif -%}
        {%- if s.signature != blank -%}<p class="tb-signature">{{ s.signature | escape }}</p>{%- endif -%}
        {%- if s.button_label != blank -%}
          {%- if s.button_style == 'link' -%}
            <a class="tb-link" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>
          {%- else -%}
            <a class="button{% if s.button_style == 'secondary' %} button--secondary{% endif %}" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tailorbird image and text",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder label" },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "portrait", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" }, { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image side", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "layout", "label": "Layout", "default": "plain", "options": [
      { "value": "plain", "label": "Plain" }, { "value": "band", "label": "Full-width colour band" }, { "value": "card", "label": "Rounded colour panel" }
    ] },
    { "type": "checkbox", "id": "show_bird", "label": "Show the little bird", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "is_page_title", "label": "This is the page title", "default": false },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h2", "options": [
      { "value": "display", "label": "Page title" }, { "value": "h2", "label": "Section heading" }
    ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Note with a clock", "info": "For example: Made to order. Ready to post in [making time]." },
    { "type": "text", "id": "signature", "label": "Signature" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "primary", "options": [
      { "value": "primary", "label": "Rust button" }, { "value": "secondary", "label": "Outline button" }, { "value": "link", "label": "Text link" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding", "label": "Space above and below", "default": "medium", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "text", "id": "anchor", "label": "Link anchor" }
  ],
  "presets": [ { "name": "Tailorbird image and text" } ]
}
{% endschema %}
