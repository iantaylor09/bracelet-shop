{%- assign s = section.settings -%}
<section class="tb-section tb-pad-medium color-{{ s.color_scheme }} gradient">
  <div class="page-width">
    <div class="tb-split tb-split--plain tb-split--image-right tb-holding">
      <div class="tb-split__media">
        {%- render 'tb-media', image: s.image, label: s.placeholder, ratio: 'portrait', sizes: '(min-width: 750px) 50vw, 100vw' -%}
      </div>
      <div class="tb-split__copy">
        <img class="tb-bird" src="{{ 'tailorbird-bird.png' | asset_url }}" alt="" width="48" height="39">
        {%- if s.eyebrow != blank -%}<p class="tb-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="tb-display">{{ s.heading | escape }}</h1>
        {%- if s.text != blank -%}<div class="tb-lede">{{ s.text }}</div>{%- endif -%}

        {%- assign form_id = 'TbHolding-' | append: section.id -%}
        {%- form 'customer', id: form_id, class: 'tb-holding__form' -%}
          <input type="hidden" name="contact[tags]" value="{{ s.tags | escape }}">
          {%- if form.posted_successfully? -%}
            <p class="tb-form-ok" role="status">{{ s.success | escape }}</p>
          {%- else -%}
            <label class="tb-field">
              <span>Your email</span>
              <span class="tb-holding__row">
                <input type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{{ form.email }}"{% if form.errors %} aria-invalid="true" autofocus{% endif %}>
                <button type="submit" class="button">{{ s.button_label | escape }}</button>
              </span>
            </label>
            {%- if form.errors -%}
              <p class="tb-form-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
        {%- if s.small_print != blank -%}<p class="tb-small tb-muted">{{ s.small_print | escape }}</p>{%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          <p><a class="tb-link" href="{{ settings.social_instagram_link }}">{{ s.instagram_label | escape }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tailorbird holding page",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Emails land in Customers, subscribed to email marketing and tagged as below, so you can send a launch email from Shopify Email." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder label", "default": "Bracelets on the wood board with a sprig of dried flowers" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Slow-made in Yorkshire" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something handmade is on its way" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Keep me posted" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you, you're on the list. I'll email you when the shop opens." },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Just the opening news and new drops, no spam. Unsubscribe any time." },
    { "type": "text", "id": "instagram_label", "label": "Instagram link label", "default": "Follow along on Instagram" },
    { "type": "text", "id": "tags", "label": "Customer tags", "default": "newsletter, holding-page" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "presets": [ { "name": "Tailorbird holding page" } ]
}
{% endschema %}
