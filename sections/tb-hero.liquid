<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="tb-hero tb-hero--{{ section.settings.height }}{% if section.settings.width == 'page' %} page-width tb-hero--inset{% endif %}"
>
  {%- render 'tb-media', image: section.settings.image, label: section.settings.placeholder, ratio: 'none', sizes: '100vw', class: 'tb-hero__media' -%}
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="{% if section.settings.width == 'full' %}page-width {% endif %}tb-hero__inner">
      <div class="tb-hero__card color-{{ section.settings.color_scheme }}">
        {%- if section.settings.eyebrow != blank -%}<p class="tb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- if section.settings.is_page_title -%}
            <h1 class="tb-display">{{ section.settings.heading | escape }}</h1>
          {%- else -%}
            <h2 class="tb-display">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="tb-lede">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
          <div class="tb-buttons">
            {%- if section.settings.button_label != blank -%}
              <a class="button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.button2_label != blank -%}
              <a class="button button--secondary" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Tailorbird hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Wide photo, about 2400 × 1200 px. Keep the left third calm for the text." },
    { "type": "text", "id": "placeholder", "label": "Placeholder label", "info": "Shown on the striped box until a photo is chosen." },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "is_page_title", "label": "This is the page title", "default": false },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Main button label" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "select", "id": "width", "label": "Width", "default": "full", "options": [
      { "value": "full", "label": "Full width" }, { "value": "page", "label": "Page width, rounded corners" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Text box colours", "default": "scheme-1" },
    { "type": "text", "id": "anchor", "label": "Link anchor", "info": "Lets menus link straight here, for example #story." }
  ],
  "presets": [ { "name": "Tailorbird hero" } ]
}
{% endschema %}
