{%- assign s = section.settings -%}
<section id="{{ s.anchor | default: 'kits' | handleize }}" class="tb-section color-{{ s.color_scheme }} gradient tb-pad-{{ s.padding }}">
  <div class="page-width">
    <div class="tb-head{% if s.see_all_label != blank %} tb-head--split{% endif %}">
      <div>
        {%- if s.eyebrow != blank -%}<p class="tb-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="tb-h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="tb-intro">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if s.see_all_label != blank -%}<a class="tb-link" href="{{ s.see_all_link | default: '#' }}">{{ s.see_all_label | escape }}</a>{%- endif -%}
    </div>

    <ul class="tb-grid tb-grid--{{ s.columns }} tb-grid--m1" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign made = b.made_product
          assign name = b.name | default: p.title
          assign url = p.url | default: b.link
        -%}
        <li class="tb-card tb-kit" {{ block.shopify_attributes }}>
          {%- if url != blank -%}<a href="{{ url }}" tabindex="-1" aria-hidden="true">{%- endif -%}
          {%- render 'tb-media', image: p.featured_image, label: b.placeholder, ratio: 'square', sizes: '(min-width: 990px) 30vw, 100vw' -%}
          {%- if url != blank -%}</a>{%- endif -%}
          <div class="tb-card__body">
            <h3 class="tb-card__title tb-card__title--medium">
              {%- if url != blank -%}<a href="{{ url }}">{{ name | escape }}</a>{%- else -%}{{ name | escape }}{%- endif -%}
            </h3>
            {%- if b.line != blank -%}<p class="tb-card__text">{{ b.line | escape }}</p>{%- endif -%}
            <p class="tb-price">
              {%- if p != blank -%}
                {{ p.price | money }}
              {%- else -%}
                {{ b.fallback_price_pence | money }}
              {%- endif -%}
              {%- if p != blank and p.available == false %} <span class="tb-muted">· Sold out</span>{%- endif -%}
            </p>
            {%- if made != blank -%}
              <a class="tb-link" href="{{ made.url }}">Rather have it made? See {{ made.title | escape }}</a>
            {%- elsif b.made_name != blank -%}
              <a class="tb-link" href="{{ b.made_link | default: '#' }}">Rather have it made? See {{ b.made_name | escape }}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "DIY kits",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "DIY kits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need, in one kraft box" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "see_all_label", "label": "Link label", "default": "See all kits" },
    { "type": "url", "id": "see_all_link", "label": "Link" },
    { "type": "range", "id": "columns", "label": "Kits per row", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "select", "id": "padding", "label": "Space above and below", "default": "medium", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "text", "id": "anchor", "label": "Link anchor", "default": "kits" }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit",
      "settings": [
        { "type": "product", "id": "product", "label": "Kit product", "info": "Gives the photo, price and link. Until then the details below are shown." },
        { "type": "text", "id": "name", "label": "Name", "info": "Kits are named after the piece they make: Make your own Starry Night." },
        { "type": "text", "id": "line", "label": "Short line", "default": "Dales zigzag · a little fiddly, very satisfying" },
        { "type": "text", "id": "placeholder", "label": "Placeholder label", "default": "Open kit box, beads in paper bags, finished bracelet beside it" },
        { "type": "number", "id": "fallback_price_pence", "label": "Price in pence before a product is chosen", "default": 1800 },
        { "type": "url", "id": "link", "label": "Link before a product is chosen" },
        { "type": "header", "content": "The finished piece" },
        { "type": "product", "id": "made_product", "label": "Ready-made piece", "info": "Adds \"Rather have it made? See …\"." },
        { "type": "text", "id": "made_name", "label": "Or its name" },
        { "type": "url", "id": "made_link", "label": "And its link" }
      ]
    }
  ],
  "presets": [ { "name": "DIY kits", "blocks": [ { "type": "kit" }, { "type": "kit" }, { "type": "kit" } ] } ]
}
{% endschema %}
