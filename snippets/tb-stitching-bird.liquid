{%- comment -%} The little tailorbird stitching beads onto a thread. Pure SVG and CSS, so it stays sharp and tiny; it sits still for people who prefer reduced motion. {%- endcomment -%}
<div class="tb-stitch" role="img" aria-label="The little tailorbird stitching beads onto a thread">
  <svg viewBox="0 0 420 200" aria-hidden="true" focusable="false">
    <g class="tb-stitch__bird"><image href="{{ 'tailorbird-bird.svg' | asset_url }}" x="0" y="18" width="170" height="136"/></g>
    <path class="tb-stitch__thread" d="M150 60 C 160 120, 170 160, 190 160 L 410 160" fill="none" stroke="#3B2F27" stroke-width="2" stroke-dasharray="9 7" stroke-linecap="round"/>
    <circle class="tb-stitch__bead tb-stitch__bead--0" cx="196" cy="160" r="11" fill="#6E7B3C" stroke="#3B2F27" stroke-width="1.5"/>
    <circle class="tb-stitch__bead tb-stitch__bead--1" cx="228" cy="160" r="11" fill="#B4532A" stroke="#3B2F27" stroke-width="1.5"/>
    <circle class="tb-stitch__bead tb-stitch__bead--2" cx="260" cy="160" r="11" fill="#D8C3A0" stroke="#3B2F27" stroke-width="1.5"/>
    <circle class="tb-stitch__bead tb-stitch__bead--3" cx="292" cy="160" r="11" fill="#8E9A78" stroke="#3B2F27" stroke-width="1.5"/>
    <circle class="tb-stitch__bead tb-stitch__bead--4" cx="324" cy="160" r="11" fill="#B4532A" stroke="#3B2F27" stroke-width="1.5"/>
    <circle class="tb-stitch__bead tb-stitch__bead--5" cx="356" cy="160" r="11" fill="#6E7B3C" stroke="#3B2F27" stroke-width="1.5"/>
    <circle class="tb-stitch__bead tb-stitch__bead--6" cx="388" cy="160" r="11" fill="#D8C3A0" stroke="#3B2F27" stroke-width="1.5"/>
    <g class="tb-stitch__needle"><line x1="0" y1="0" x2="26" y2="0" stroke="#6B635B" stroke-width="2.5" stroke-linecap="round"/><circle cx="23" cy="0" r="2" fill="none" stroke="#6B635B" stroke-width="1.2"/></g>
  </svg>
</div>
